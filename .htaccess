# The installation folder is the document root. From the web, only the files in assets/ and brand/
# answer as they are. Every other address goes to the app: its pages, and also the address of any
# file in config/, data/, src/, vendor/, or elsewhere, which the app answers with "not found".
# config/ and data/ also deny all access on their own.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(assets|brand)/ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Without mod_rewrite, Apache would hand out every file as it is. Nothing goes out then.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
