{% extends 'layout.html.twig' %}

{# Literal keys, so the translation check sees every one of them. #}
{% set title = {
    bad_request: 'error.bad_request.title'|trans,
    not_found: 'error.not_found.title'|trans,
    forbidden: 'error.forbidden.title'|trans,
    csrf: 'error.csrf.title'|trans,
    server: 'error.server.title'|trans,
    busy: 'error.busy.title'|trans,
    busy_load: 'error.busy_load.title'|trans,
    ahead: 'error.ahead.title'|trans,
    ahead_no_backup: 'error.ahead.title'|trans,
}[kind] %}
{% set text = {
    bad_request: 'error.bad_request.text'|trans,
    not_found: 'error.not_found.text'|trans,
    forbidden: 'error.forbidden.text'|trans,
    csrf: 'error.csrf.text'|trans,
    server: 'error.server.text'|trans,
    busy: 'error.busy.text'|trans,
    busy_load: 'error.busy_load.text'|trans,
    ahead: 'error.ahead.text'|trans({backup: backup ?? ''}),
    ahead_no_backup: 'error.ahead.text_no_backup'|trans,
}[kind] %}

{% block title %}{{ title }} · {{ parent() }}{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}
<main class="main" id="main" tabindex="-1">
    <div class="error-page">
        <h1>{{ title }}</h1>
        <p class="lead">{{ text }}</p>
        <div class="actions">
            <a class="btn primary" href="/">{{ 'error.home'|trans }}</a>
        </div>
        {% if details %}
            <pre class="details">{{ details }}</pre>
        {% endif %}
    </div>
</main>
{% endblock %}
