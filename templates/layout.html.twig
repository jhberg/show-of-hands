<!doctype html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    {# 422 answers a refused form: htmx swaps it in, so the message shows at its field. #}
    <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"responseHandling":[{"code":"204","swap":false},{"code":"422","swap":true},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true}]}'>
    <title>{% block title %}{{ 'app.page_title'|trans({brand: brand.name}) }}{% endblock %}</title>
    <link rel="icon" href="{{ brand_assets.favicon }}">
    <link rel="stylesheet" href="{{ theme_url }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/app.css') }}">
    <script src="{{ asset('/assets/vendor/htmx-2.0.11.min.js') }}" defer></script>
    <script src="{{ asset('/assets/js/app.js') }}" defer></script>
</head>
<body>
{% block body %}{% endblock %}
{{ include('partials/toast.html.twig') }}
</body>
</html>
