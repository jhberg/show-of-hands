{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin.polls.title'|trans }} · {{ 'nav.admin'|trans }} · {{ parent() }}{% endblock %}

{% block body %}
{{ include('partials/header.html.twig', {active: 'admin', section: 'polls'}) }}
<main class="main">
    {{ include('partials/admin/tabs.html.twig', {section: 'polls'}) }}
    {# The mockup shows no heading here. Screen readers still need one to name the page. #}
    <h1 class="sr">{{ 'poll.missing_title'|trans }}</h1>
    <a class="back" href="/admin/polls">{{ icon('arrow') }}{{ 'poll.back'|trans }}</a>
    <div class="empty">{{ 'admin.polls.missing'|trans({days: retention_days}) }}</div>
</main>
{% endblock %}
