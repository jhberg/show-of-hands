{#
    The member file. ?import=1 opens what an import would add, with its confirmation, so it works
    without JavaScript. An import only adds: members already on the list stay as they are.
#}
<section class="panel soft mt-18" id="member-import">
    <h2>{{ 'admin.members.import.title'|trans }}</h2>
    {% if not import.exists %}
        <p class="help">{{ 'admin.members.import.missing'|trans({file: import.file}) }}</p>
    {% else %}
        <p class="help">
            {{- import.at is null
                ? 'admin.members.import.never'|trans({file: import.file})
                : 'admin.members.import.last'|trans({file: import.file, moment: import.at|moment}) -}}
        </p>
        {% set preview = import.preview %}
        {% if preview is null %}
            {% set import_url = '/admin/members?' ~ (query is empty ? {} : {q: query})|merge({import: 1})|url_encode %}
            <div class="row mt-10">
                <a class="btn" id="member-import-open" href="{{ import_url }}#member-import" hx-get="{{ import_url }}" hx-replace-url="true">{{ 'admin.members.import.open'|trans }}</a>
            </div>
        {% else %}
            <form class="warnbox" method="post" action="/admin/members/import" hx-post="/admin/members/import">
                {{ include('partials/csrf_field.html.twig') }}
                <input type="hidden" name="q" value="{{ query }}">
                {% if preview.added is empty %}
                    <p><b>{{ 'admin.members.import.nothing_new'|trans }}</b></p>
                {% else %}
                    <p><b>{{ 'admin.members.import.question'|trans({count: preview.added|length}) }}</b> {{ 'admin.members.import.text'|trans }}</p>
                    <ul class="import-list">
                        {% for added in preview.added %}
                            <li>
                                <b>{{ added.name }}</b>
                                {%- if added.display_name is not null %} · {{ 'admin.members.display_name'|trans({name: added.display_name}) }}{% endif %}
                                {%- if added.group is not null %} · {{ added.group }}{% endif %}
                                {%- if added.board %} · {{ 'role.board'|trans }}{% endif %}
                                {%- if added.admin %} · {{ 'role.admin'|trans }}{% endif %}
                                {%- if added.inactive %} · {{ 'admin.members.inactive'|trans }}{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if preview.existing > 0 %}
                    <p>{{ 'admin.members.import.existing'|trans({count: preview.existing}) }}</p>
                {% endif %}
                {% if preview.problems is not empty %}
                    <p><b>{{ 'admin.members.import.problems'|trans({count: preview.problems|length}) }}</b></p>
                    <ul class="import-list">
                        {% for problem in preview.problems %}
                            <li>{{ problem }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <div class="row">
                    {% if preview.added is not empty %}
                        {# htmx moves the focus here after the swap, so the second tap is one key away. #}
                        <button class="btn primary" autofocus>{{ 'admin.members.import.confirm'|trans }}</button>
                    {% endif %}
                    <a class="btn" data-focus="member-import-open" href="{{ list_url }}#member-import" hx-get="{{ list_url }}" hx-replace-url="true">{{ 'admin.members.cancel'|trans }}</a>
                </div>
            </form>
        {% endif %}
    {% endif %}
</section>
