{#
    The member panel. Open forms and confirmations live in GET parameters (?add=1, ?edit={id},
    ?delete={id}, ?import=1), so they work without JavaScript; with htmx, links and forms swap this panel.
    A saved form starts the list afresh, so the new or edited member shows whatever the search was.
#}
<div id="members" hx-target="this" hx-swap="outerHTML">
    <div class="page-head">
        <div>
            <h1>{{ 'admin.members.title'|trans }}</h1>
            <p class="lead">{{ 'admin.members.lead'|trans }}</p>
        </div>
        {% if form is null %}
            <a class="btn primary" id="member-add" href="/admin/members?add=1#member-form" hx-get="/admin/members?add=1" hx-replace-url="true">{{ 'admin.members.add'|trans }}</a>
        {% endif %}
    </div>
    {% if form is not null %}
        {{ include('partials/admin/member_form.html.twig') }}
    {% endif %}
    <p class="stat num mb-10">
        <b>{{ counts.eligible }}</b> {{ 'admin.members.count.eligible'|trans({count: counts.eligible}) }}
        · <b>{{ counts.board }}</b> {{ 'admin.members.count.board'|trans({count: counts.board}) }}
        · <b>{{ counts.admin }}</b> {{ 'admin.members.count.admin'|trans({count: counts.admin}) }}
        {%- if counts.inactive > 0 %} · <b>{{ counts.inactive }}</b> {{ 'admin.members.count.inactive'|trans({count: counts.inactive}) }}{% endif %}
    </p>
    {# Enter submits the search without JavaScript. With htmx, typing swaps only the list. #}
    <form class="search" role="search" method="get" action="/admin/members">
        <label class="sr" for="m-q">{{ 'admin.members.search_label'|trans }}</label>
        {# An open form stays open in the URL the search leaves behind. #}
        {% if form is not null %}
            <input type="hidden" name="{{ form.memberId is null ? 'add' : 'edit' }}" value="{{ form.memberId ?? 1 }}">
        {% endif %}
        <input type="search" id="m-q" name="q" value="{{ query }}" placeholder="{{ 'admin.members.search_placeholder'|trans }}" autocomplete="off"
            hx-get="/admin/members" hx-include="closest form" hx-trigger="input changed delay:200ms, search" hx-target="#member-list" hx-replace-url="true">
    </form>
    {{ include('partials/admin/member_list.html.twig') }}
    {{ include('partials/admin/member_import.html.twig') }}
</div>
