{#
    A poll's detail: head, the panel for its status with its actions, the result or the note that
    none exists yet, and the turnout. Confirmations live in ?confirm=delete and ?confirm=reopen, so
    they work without JavaScript; with htmx, links and buttons swap this element.
#}
{% set url = '/admin/polls/' ~ poll.id %}
{% set exception = poll.kind.value == 'exception' %}
<div id="poll-detail" hx-target="this" hx-swap="outerHTML">
    <div class="page-head">
        <div>
            <p class="kicker">{{ exception ? 'admin.polls.kind.exception'|trans : 'admin.polls.kind.admission'|trans }} · {{ group_label }} · {{ include('partials/poll/date.html.twig') }}</p>
            <h1>{{ poll.subjectName }}</h1>
            {% if exception %}<p class="note"><b>{{ poll.question ?? 'poll.question_missing'|trans }}</b></p>{% endif %}
            {% if poll.note != '' %}<p class="note">{{ poll.note }}</p>{% endif %}
        </div>
        {{ include('partials/poll/status_chip.html.twig') }}
    </div>

    <div class="panel soft" id="poll-status">
        {% if poll.isDraft %}
            <h2>{{ 'poll.status.draft'|trans }}</h2>
            <p class="help">{{ 'admin.polls.draft.help'|trans }}</p>
            <div class="actions">
                <form method="post" action="{{ url }}/publish" hx-post="{{ url }}/publish">
                    {{ include('partials/csrf_field.html.twig') }}
                    <button class="btn primary">{{ 'admin.polls.draft.publish'|trans }}</button>
                </form>
                <a class="btn" href="{{ url }}/edit">{{ 'admin.polls.draft.edit'|trans }}</a>
                <a class="btn danger" href="{{ url }}?confirm=delete#poll-status" hx-get="{{ url }}?confirm=delete" hx-replace-url="true">{{ 'admin.polls.draft.delete'|trans }}</a>
            </div>
            {% if confirm == 'delete' %}
                <form class="warnbox" method="post" action="{{ url }}/delete" hx-post="{{ url }}/delete">
                    {{ include('partials/csrf_field.html.twig') }}
                    <p><b>{{ 'admin.polls.draft.delete_question'|trans }}</b> {{ 'admin.polls.draft.delete_text'|trans }}</p>
                    <div class="row">
                        {# htmx moves the focus here after the swap, so the second tap is one key away. #}
                        <button class="btn danger" autofocus>{{ 'admin.polls.draft.delete_confirm'|trans }}</button>
                        <a class="btn" href="{{ url }}#poll-status" hx-get="{{ url }}" hx-replace-url="true">{{ 'admin.polls.cancel'|trans }}</a>
                    </div>
                </form>
            {% endif %}
            {{ include('partials/admin/share_box.html.twig') }}
        {% elseif poll.isOpen %}
            <h2>{{ poll.openedAt is null ? 'poll.status.open'|trans : 'admin.polls.open.title'|trans({moment: poll.openedAt|moment}) }}</h2>
            <p class="help">
                {{- board_names is empty ? 'admin.polls.open.help'|trans : 'admin.polls.open.help_board'|trans({names: board_names|join(', ')}) -}}
                {%- if poll.reopenedAt is not null %} {{ 'admin.polls.open.reopened'|trans({moment: poll.reopenedAt|moment}) }}{% endif -%}
            </p>
            <div class="actions">
                <a class="btn" href="/polls/{{ poll.id }}">{{ 'admin.polls.to_poll'|trans }}</a>
                <a class="btn ghost" href="{{ url }}/edit">{{ 'admin.polls.open.edit'|trans }}</a>
            </div>
            {{ include('partials/admin/share_box.html.twig') }}
        {% else %}
            <h2>{{ 'admin.polls.closed.title'|trans({moment: poll.closedAt|moment}) }}</h2>
            <p class="help">
                {{- 'admin.polls.closed.help'|trans({eligible: poll.tally.eligible ?? turnout.eligible}) -}}
                {%- if deletion_day is not null %} {{ 'admin.polls.closed.deletion'|trans({date: deletion_day|day_date}) }}{% endif -%}
            </p>
            <div class="actions">
                <a class="btn" href="/polls/{{ poll.id }}">{{ 'admin.polls.to_poll'|trans }}</a>
                {% if can_reopen %}
                    <a class="btn danger" href="{{ url }}?confirm=reopen#poll-status" hx-get="{{ url }}?confirm=reopen" hx-replace-url="true">{{ 'admin.polls.closed.reopen'|trans }}</a>
                {% else %}
                    <button class="btn" disabled>{{ 'admin.polls.closed.reopen'|trans }}</button>
                {% endif %}
            </div>
            <p class="help mt-10">{{ can_reopen ? 'admin.polls.closed.reopen_today'|trans : 'admin.polls.closed.reopen_over'|trans }}</p>
            {% if can_reopen and confirm == 'reopen' %}
                <form class="warnbox" method="post" action="{{ url }}/reopen" hx-post="{{ url }}/reopen">
                    {{ include('partials/csrf_field.html.twig') }}
                    <p><b>{{ 'admin.polls.closed.reopen_question'|trans }}</b> {{ 'admin.polls.closed.reopen_text'|trans }}</p>
                    <div class="row">
                        <button class="btn danger" autofocus>{{ 'admin.polls.closed.reopen_confirm'|trans }}</button>
                        <a class="btn" href="{{ url }}#poll-status" hx-get="{{ url }}" hx-replace-url="true">{{ 'admin.polls.cancel'|trans }}</a>
                    </div>
                </form>
            {% endif %}
        {% endif %}
    </div>

    {% if poll.isOpen %}
        <div class="panel">
            <div class="lock mt-0">{{ icon('lock') }}<span><b>{{ 'admin.polls.open.lock_label'|trans }}</b> {{ 'admin.polls.open.lock'|trans }}</span></div>
        </div>
    {% elseif poll.tally is not null %}
        <div class="panel">{{ include('partials/poll/result.html.twig') }}</div>
    {% endif %}
    {% if turnout is not null %}
        <div class="panel">{{ include('partials/poll/turnout.html.twig') }}</div>
    {% endif %}
</div>
