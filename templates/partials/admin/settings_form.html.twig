{# The settings form. The majority's example counts with today's member count, as if every member voted. #}
<form class="panel form narrow mt-18" id="settings" method="post" action="/admin/settings" hx-post="/admin/settings" hx-target="this" hx-swap="outerHTML">
    {{ include('partials/csrf_field.html.twig') }}
    <fieldset>
        <legend>{{ 'admin.settings.majority.legend'|trans }}</legend>
        {# Literal keys, so the translation check sees every one of them. #}
        {% set share_labels = {
            half: 'admin.settings.majority.share.half'|trans,
            two_thirds: 'admin.settings.majority.share.two_thirds'|trans,
            three_quarters: 'admin.settings.majority.share.three_quarters'|trans,
        } %}
        {% set base_labels = {
            eligible: 'admin.settings.majority.base.eligible'|trans,
            cast: 'admin.settings.majority.base.cast'|trans,
        } %}
        {% set base = settings.majority.base.value %}
        <div class="inline-sel">
            <label for="s-share">{{ 'admin.settings.majority.before'|trans }}</label>
            <select id="s-share" name="majority">
                {% for share in majority_shares %}
                    <option value="{{ share.value }}"{% if share == settings.majority.share %} selected{% endif %}>{{ share_labels[share.value] }}</option>
                {% endfor %}
            </select>
            <select id="s-base" name="majority_base" aria-label="{{ 'admin.settings.majority.base_label'|trans }}">
                {% for choice in majority_bases %}
                    <option value="{{ choice.value }}"{% if choice.value == base %} selected{% endif %}>{{ base_labels[choice.value] }}</option>
                {% endfor %}
            </select>
        </div>
        <p class="help">{{ 'admin.settings.majority.example'|trans({base: base, eligible: eligible, needed: needed}) }} {{ 'admin.settings.majority.abstention'|trans({base: base}) }} {{ 'admin.settings.majority.text'|trans }}</p>
    </fieldset>
    <fieldset>
        <legend>{{ 'admin.settings.delegation.legend'|trans }}</legend>
        <label class="check">
            <input type="checkbox" name="delegation" value="1"{% if settings.delegationEnabled %} checked{% endif %}>
            <span><b>{{ 'admin.settings.delegation.enabled'|trans }}</b><br><span class="help">{{ 'admin.settings.delegation.help'|trans }}</span></span>
        </label>
        <div class="inline-sel">
            <label for="s-max">{{ 'admin.settings.delegation.max_before'|trans }}</label>
            <select id="s-max" name="max_received">
                {% for choice in max_received_choices %}
                    <option value="{{ choice }}"{% if choice == settings.maxReceived %} selected{% endif %}>{{ choice }}</option>
                {% endfor %}
            </select>
            <span>{{ 'admin.settings.delegation.max_after'|trans({weight: settings.maxReceived + 1}) }}</span>
        </div>
    </fieldset>
    <fieldset>
        <legend>{{ 'admin.settings.visibility.legend'|trans }}</legend>
        <label class="check">
            <input type="checkbox" name="show_open_names" value="1"{% if settings.showOpenNames %} checked{% endif %}>
            <span><b>{{ 'admin.settings.visibility.show_open_names'|trans }}</b><br><span class="help">{{ 'admin.settings.visibility.help'|trans }}</span></span>
        </label>
    </fieldset>
    <fieldset>
        <legend>{{ 'admin.settings.retention.legend'|trans }}</legend>
        <div class="inline-sel">
            <label for="s-ret">{{ 'admin.settings.retention.before'|trans }}</label>
            <select id="s-ret" name="retention_days">
                {% for choice in retention_days_choices %}
                    <option value="{{ choice }}"{% if choice == settings.retentionDays %} selected{% endif %}>{{ choice }}</option>
                {% endfor %}
            </select>
            <span>{{ 'admin.settings.retention.after'|trans }}</span>
        </div>
        <p class="help">{{ 'admin.settings.retention.help'|trans }}</p>
    </fieldset>
    <div class="row">
        {# The id keeps the focus here when htmx swaps the panel. #}
        <button class="btn primary" id="s-save">{{ 'admin.settings.save'|trans }}</button>
    </div>
</form>
