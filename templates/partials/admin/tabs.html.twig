{# The admin area's sections. section names the one that shows. #}
<nav class="tabs" aria-label="{{ 'nav.admin'|trans }}">
    {%- for tab in admin_sections %}
        <a href="{{ tab.path }}"{% if section == tab.key %} class="on" aria-current="page"{% endif %}>{{ tab.label|trans }}</a>
    {%- endfor %}
</nav>
