{#
    active names the open area (home or admin), section the open admin section.
    Only admins get a nav: on the desktop the tabs, on the phone a menu in place of the sign-out
    button that lists every section. Everyone else reaches the start page through the brand.
#}
{% set active = active|default(null) %}
{% set section = section|default(null) %}
<header class="top">
    <div class="top-in">
        <a class="brand" href="/">
            {%- set header_logo = brand_assets.headerLogo -%}
            {%- if header_logo -%}
                {{- include('partials/brand_logo.html.twig', {src: header_logo, dark: brand_assets.headerLogoDark, class: 'hlogo'}) -}}
            {%- else -%}
                {{ include('partials/wordmark.html.twig') }}
            {%- endif -%}
            <small>{{ 'app.title'|trans }}</small>
        </a>
        {% if member and member.isAdmin %}
            <nav class="nav" aria-label="{{ 'nav.label'|trans }}">
                <a href="/"{% if active == 'home' %} class="on" aria-current="page"{% endif %}>{{ 'nav.vote'|trans }}</a>
                <a href="/admin/polls"{% if active == 'admin' %} class="on" aria-current="page"{% endif %}>{{ 'nav.admin'|trans }}</a>
            </nav>
        {% endif %}
        <div class="top-lang">
            {{ include('partials/locale_switch.html.twig') }}
        </div>
        {% if member %}
            <div class="user{% if member.isAdmin %} with-menu{% endif %}">
                <span class="avatar" aria-hidden="true">{{ member.initials }}</span>
                <span class="uname">{{ member.shownName }}</span>
                <form class="logout" method="post" action="/logout">
                    {{ include('partials/csrf_field.html.twig') }}
                    <button class="btn ghost icon" aria-label="{{ 'nav.logout'|trans }}" title="{{ 'nav.logout'|trans }}">{{ icon('logout') }}</button>
                </form>
                {% if member.isAdmin %}
                    <details class="menu">
                        <summary class="btn ghost icon" aria-label="{{ 'nav.menu'|trans }}" title="{{ 'nav.menu'|trans }}">{{ icon('menu') }}</summary>
                        <nav class="menu-panel" aria-label="{{ 'nav.label'|trans }}">
                            <a href="/"{% if active == 'home' %} aria-current="page"{% endif %}>{{ 'nav.vote'|trans }}</a>
                            <p class="menu-head" id="menu-admin">{{ 'nav.admin'|trans }}</p>
                            <ul aria-labelledby="menu-admin">
                                {%- for item in admin_sections %}
                                    <li><a href="{{ item.path }}"{% if section == item.key %} aria-current="page"{% endif %}>{{ item.label|trans }}</a></li>
                                {%- endfor %}
                            </ul>
                            <form method="post" action="/logout">
                                {{ include('partials/csrf_field.html.twig') }}
                                <button>{{ icon('logout') }}{{ 'nav.logout'|trans }}</button>
                            </form>
                        </nav>
                    </details>
                {% endif %}
            </div>
        {% endif %}
    </div>
</header>
