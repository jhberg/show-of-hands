{% set admission = poll.kind.value == 'admission' %}
<section class="ballot">
    <h2>{{ 'ballot.title'|trans }}</h2>
    {% if recipient is not null %}
        <div class="notice">{{ icon('arrow') }}<div>
            <b>{{ 'ballot.delegated.title'|trans({name: recipient.name}) }}</b>
            {% if recipient_voted is null -%}
                {{ 'ballot.delegated.back'|trans }}
            {%- elseif recipient_voted -%}
                {{ 'ballot.delegated.voted'|trans({name: recipient.firstName}) }}
            {%- else -%}
                {{ 'ballot.delegated.not_voted'|trans({name: recipient.firstName}) }}
            {%- endif %}
            <form method="post" action="/polls/{{ poll.id }}/delegation/revoke" hx-post="/polls/{{ poll.id }}/delegation/revoke" hx-target="closest main" hx-swap="outerHTML">
                {{ include('partials/csrf_field.html.twig') }}
                <button class="link" id="deleg-revoke">{{ 'ballot.delegated.revoke'|trans }}</button>
            </form>
        </div></div>
    {% endif %}
    {% if senders is not empty %}
        {% set weight = senders|length + 1 %}
        <div class="weight"><span class="x">×{{ weight }}</span><span><b>{{ 'ballot.weight.title'|trans({weight: weight}) }}</b> {{ 'ballot.weight.text'|trans({count: senders|length, names: senders|name_list, weight: weight}) }}</span></div>
    {% endif %}
    <p class="q">
        {%- if admission -%}
            {{ 'ballot.question.admission'|trans({name: poll.subjectName}) }}
        {%- else -%}
            {{ poll.question ?? 'poll.question_missing'|trans }}
        {%- endif -%}
    </p>
    <form method="post" action="/polls/{{ poll.id }}/ballot" hx-post="/polls/{{ poll.id }}/ballot" hx-target="closest main" hx-swap="outerHTML">
        {{ include('partials/csrf_field.html.twig') }}
        <div class="choices" role="group" aria-label="{{ 'ballot.group'|trans }}">
            {% for option in ['yes', 'no'] %}
                {% set pressed = choice is not null and choice.value == option %}
                {# Ids let htmx keep the focus on the tapped button across the swap. #}
                <button class="choice" id="choice-{{ option }}" name="choice" value="{{ option }}" aria-pressed="{{ pressed ? 'true' : 'false' }}">
                    {%- if option == 'yes' -%}
                        <span class="big">{{ 'ballot.yes'|trans }}</span><small>{{ admission ? 'ballot.sub.admission_yes'|trans : 'ballot.sub.exception_yes'|trans }}</small>
                    {%- else -%}
                        <span class="big">{{ 'ballot.no'|trans }}</span><small>{{ admission ? 'ballot.sub.admission_no'|trans : 'ballot.sub.exception_no'|trans }}</small>
                    {%- endif -%}
                    {%- if pressed %}<span class="sel">{{ icon('check') }}{{ 'ballot.yours'|trans }}</span>{% endif -%}
                </button>
            {% endfor %}
        </div>
    </form>
    {% if choice is not null %}
        <div class="reg">{{ icon('check') }}<span><b>{{ choice.value == 'yes' ? 'ballot.registered_yes'|trans : 'ballot.registered_no'|trans }}</b> {{ 'ballot.registered_text'|trans }}</span></div>
    {% elseif recipient is null %}
        <p class="help mt-12">{{ 'ballot.hint'|trans }}</p>
    {% endif %}
    {% if delegation is not null %}
        {{ include('partials/poll/delegation.html.twig') }}
    {% endif %}
</section>
